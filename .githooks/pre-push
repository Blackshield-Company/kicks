#!/usr/bin/env bash
# Rejects pushes containing commits not authored/committed with the noreply email.
# Enable with: git config core.hooksPath .githooks
#
# Git passes one line per ref update on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# The pushed range is derived from that update, never from local tracking refs
# that may be stale or rewritten:
#   - existing remote ref: check <remote sha>..<local sha>
#   - new remote ref (remote sha is all zeros): check the commits not reachable from
#     the remote's current default branch tip, read live with `git ls-remote`.
#     If the tip cannot be read, or is not present locally (run `git fetch <remote>`),
#     the push is rejected. If the remote has no default branch yet, the full history
#     of the pushed commit is checked (fail closed).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
remote="${1:-}"
# The push destination (URL) is what git will update; it can differ from the fetch URL.
dest="${2:-$remote}"

# Print the remote's current default-branch tip sha. Prints nothing if the remote
# has no HEAD (for example an empty repository). Returns 1 if the remote is unreachable.
default_tip() {
  local out
  out="$(git ls-remote "$dest" HEAD </dev/null 2>/dev/null)" || return 1
  awk '$2 == "HEAD" { print $1; exit }' <<<"$out"
}

# shellcheck disable=SC2034  # rref is part of the stdin format but unused
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue          # deletion
  if [ "$rsha" = "$zero" ]; then
    # New remote ref: exclude only the remote's live default branch tip.
    if ! tip="$(default_tip)"; then
      echo "pre-push: cannot read the default branch of '$remote'; not pushing unchecked commits" >&2
      exit 1
    fi
    if [ -z "$tip" ]; then
      echo "pre-push: '$remote' has no default branch; checking the full history of $lref" >&2
      "$root/scripts/check-noreply.sh" "$lsha"
    elif git cat-file -e "$tip^{commit}" 2>/dev/null; then
      "$root/scripts/check-noreply.sh" "$lsha" --not "$tip"
    else
      echo "pre-push: default branch tip $tip of '$remote' not present locally; run 'git fetch $remote' and retry" >&2
      exit 1
    fi
  else
    if ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
      echo "pre-push: remote tip $rsha not present locally; run 'git fetch $remote' and retry" >&2
      exit 1
    fi
    "$root/scripts/check-noreply.sh" "$rsha..$lsha"
  fi
done
